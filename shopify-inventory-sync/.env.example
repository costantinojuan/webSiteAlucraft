SHOPIFY_STORE_DOMAIN=v4apub-im.myshopify.com

# Auth Shopify (elegí una opción)
SHOPIFY_CLIENT_ID=tu_client_id
SHOPIFY_CLIENT_SECRET=shpss_tu_secreto
# SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_token_legacy

# Product IDs (npm run list-ids)
PRODUCT_ID_SILLON_1=
PRODUCT_ID_SILLON_3=
PRODUCT_ID_MESA=
PRODUCT_ID_JUEGO=
# Opcional — para tarjeta de reposeras en el dashboard
PRODUCT_ID_REPOSERA=

# Opcional — si no está, se detecta automáticamente
# LOCATION_ID=

# Ya no se usa: las piezas de mesa son productos "Pieza …"
# PRODUCT_ID_MESA_COMPONENT=

# components (default) = stock terminado desde BOM | legacy = solo Juego Living
# INVENTORY_SYNC_MODE=components

SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=2025-04
PORT=3000

# URL pública de Vercel (scripts check-deploy / register-webhooks)
# APP_BASE_URL=https://TU-PROYECTO.vercel.app

# --- Panel admin privado (/admin) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambiar_por_una_clave_segura
SESSION_SECRET=generar_un_string_largo_aleatorio

# --- Umbrales de alerta de stock bajo ---
ALERT_THRESHOLD_SILLON_1=4
ALERT_THRESHOLD_SILLON_3=2
ALERT_THRESHOLD_MESA=2
ALERT_THRESHOLD_REPOSERA=2
ALERT_THRESHOLD_JUEGO=1

# --- WhatsApp (opcional) ---
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_TO=+549XXXXXXXXXX
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# WHATSAPP_PROVIDER=cloud_api
# WHATSAPP_TO=549XXXXXXXXXX
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_CLOUD_PHONE_NUMBER_ID=
