RewriteEngine On

# Redirigir de HTTP a HTTPS y eliminar 'www' utilizando THE_REQUEST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.*)\sHTTP/ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.alucraft\.com\.ar$ [NC]
RewriteRule ^ https://alucraft.com.ar/%1 [R=301,L]

# Quitar index.html de la URL
RewriteRule ^index\.html$ / [R=301,L]

# Redirigir rutas viejas .html a las URLs limpias (301, evita URLs duplicadas)
RewriteCond %{THE_REQUEST} \s/+pagina2/pergolas\.html[\s?] [NC]
RewriteRule ^ /pergolas/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+pagina3/mobiliarioExterior\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteRule ^pagina3/?$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+mobiliarioExterior/?[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+pagina4/contacto\.html[\s?] [NC]
RewriteRule ^ /contacto/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+pagina5/preguntas\.html[\s?] [NC]
RewriteRule ^ /preguntas-frecuentes/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+armado/armado\.html[\s?] [NC]
RewriteRule ^ /armado/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+armado/(sillon-1-cuerpo|sillon-3-cuerpos|mesa-ratona|reposera)\.html[\s?] [NC]
RewriteRule ^ /armado/%1 [R=301,L]

# Reescritura de URLs limpias a archivos reales
RewriteRule ^pergolas/?$ pagina2/pergolas.html [L]
RewriteRule ^contacto/?$ pagina4/contacto.html [L]
RewriteRule ^preguntas-frecuentes/?$ pagina5/preguntas.html [L]
RewriteRule ^armado$ /armado/ [R=301,L]
RewriteRule ^armado/$ armado/index.html [L]
RewriteRule ^armado/sillon-1-cuerpo/?$ armado/sillon-1-cuerpo.html [L]
RewriteRule ^armado/sillon-3-cuerpos/?$ armado/sillon-3-cuerpos.html [L]
RewriteRule ^armado/mesa-ratona/?$ armado/mesa-ratona.html [L]
RewriteRule ^armado/reposera/?$ armado/reposera.html [L]
RewriteRule ^catalogo$ /catalogo/ [R=301,L]
RewriteRule ^catalogo/$ catalogo/mobiliario.html [L]
